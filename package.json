{
  "name": "said-vs-did",
  "private": true,
  "type": "module",
  "description": "Checks what a website's privacy policy says against what the site actually loads, with open-weight models on Mozilla's Otari gateway",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "scan": "tsx src/cli.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "packageManager": "pnpm@11.3.0",
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
